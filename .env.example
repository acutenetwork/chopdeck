# The Acute merchant API. The host decides sandbox vs live, so going to production
# is a URL + key swap with no code change.
#   Sandbox: https://sandbox.api.acute.network
#   Live:    https://api.acute.network
ACUTE_API_BASE=https://sandbox.api.acute.network

# A sandbox API key: Acute console → Developers → API keys.
ACUTE_API_KEY=acuinf_sandbox_xxx

# The signing secret shown once when you register this app's webhook URL
# (http://<this-app>/api/webhooks/acute) in the Acute console.
ACUTE_WEBHOOK_SECRET=whsec_xxx

# Turso (libSQL) — this app's own data.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_DATABASE_SECRET=your-turso-auth-token

# --- The browser SDK (@acutenetwork/react) -------------------------------------
# A publishable key: Acute console → Developers → Client apps. Public by design;
# it ships in the JavaScript bundle. What makes it safe is the origin allowlist
# on the client app, which must include this site (http://localhost:3000 in dev).
NEXT_PUBLIC_ACUTE_PUBLISHABLE_KEY=acuinf_sandbox_pk_xxx

# Only when running against a local Acute stack. Delete it in production and the
# SDK works the host out from the key's own mode.
NEXT_PUBLIC_ACUTE_API_BASE=http://localhost:9035
